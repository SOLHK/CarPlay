@@ -0,0 +1,11 @@
+package com.shilapi.xcertplay;
+import android.view.View;import android.widget.TextView;
+/** Refresh only while the settings view is attached. No per-frame GPS work. */
+public final class LocationPanel implements Runnable,View.OnAttachStateChangeListener {
+ private final TextView view;private boolean attached;
+ private LocationPanel(TextView v){view=v;}
+ public static void bind(TextView v){LocationPanel p=new LocationPanel(v);v.setText(GnssTelemetry.describe());v.addOnAttachStateChangeListener(p);if(v.isAttachedToWindow())p.onViewAttachedToWindow(v);}
+ public void onViewAttachedToWindow(View v){attached=true;view.removeCallbacks(this);run();}
+ public void onViewDetachedFromWindow(View v){attached=false;view.removeCallbacks(this);}
+ public void run(){if(!attached)return;if(view.isShown())view.setText(GnssTelemetry.describe());view.postDelayed(this,1000);}
+}
